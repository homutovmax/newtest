{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "Snake Game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "win": {
      "target": "portable",
      "icon": "snake.ico"
    },
    "portable": {
      "artifactName": "snake.exe"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}